# Disha AI Health Coach — Environment Configuration Template
# Copy this file to .env and configure your variables: cp .env.example .env

# Environment Mode: development | production
ENV=development
APP_NAME="Disha AI Health Coach"
PORT=8000

# Google Gemini API Configuration (Free-Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Conversational model: gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Background extraction & memory model (lightweight, higher RPM): gemini-2.0-flash-lite or gemini-1.5-flash
GEMINI_EXTRACTION_MODEL=gemini-2.0-flash-lite

# Optional Alternative Provider: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Rate Limiting & Free-Tier Budget Protection
# Max requests per minute per user (protects Gemini 15 RPM free limit)
RATE_LIMIT_RPM=15
# Max concurrent generations per user (prevents accidental duplicate calls)
MAX_CONCURRENT_PER_USER=1
# Daily API call budget (halts background extractions if approaching 1,500 RPD)
DAILY_REQUEST_BUDGET=1400
# Token caps to conserve quota
MAX_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=800

# Database & Storage
DATABASE_PATH=data/disha.db

# Audio & Voice Settings
TTS_VOICE=en-IN-NeerjaNeural
