# Disha AI Deterministic Voice Health Coach — Environment Configuration Template
# Copy this file to .env and configure your secrets: cp .env.example .env

# LLM Providers (Groq Llama-3.3-70B / Gemini Flash)
GROQ_API_KEY=dummy_token_scrubbed
GEMINI_API_KEY=dummy_token_scrubbed

# PostgreSQL Database Configuration
POSTGRES_USER=disha
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=disha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Edge-TTS Hindi Voice Model
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# Audit WAL Path (Optional local SQLite WAL override)
# AUDIT_WAL_PATH=disha_core/audit_wal.db

