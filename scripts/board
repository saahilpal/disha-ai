#!/usr/bin/env python3
"""Disha AI Shared Agent Brain - Board CLI (scripts/board).

Provides an append-only message log for multi-agent coordination.
Fields: ts, from, to, type, topic, body, refs.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

BOARD_PATH = Path(__file__).resolve().parent.parent / "agent" / "board" / "board.jsonl"
BOARD_MD_PATH = Path(__file__).resolve().parent.parent / "agent" / "BOARD.md"

VALID_TYPES = {
    "FINDING", "DECISION", "REQUEST", "BLOCKER",
    "INTERFACE_CHANGE", "DONE", "LESSON", "STATUS"
}


def ensure_board_file() -> None:
    BOARD_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not BOARD_PATH.exists():
        BOARD_PATH.touch()


def post_message(
    from_agent: str,
    to_agent: str,
    msg_type: str,
    topic: str,
    body: str,
    refs: str | None = None,
) -> None:
    ensure_board_file()
    msg_type_clean = msg_type.upper().strip()
    if msg_type_clean not in VALID_TYPES:
        print(f"Warning: type '{msg_type}' not in {sorted(VALID_TYPES)}, saving anyway", file=sys.stderr)

    record = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "from": from_agent.strip(),
        "to": to_agent.strip() or "all",
        "type": msg_type_clean,
        "topic": topic.strip(),
        "body": body.strip(),
        "refs": [r.strip() for r in (refs or "").split(",") if r.strip()],
    }

    with open(BOARD_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")

    print(f"✓ Posted [{record['type']}] from {record['from']} to {record['to']}: {record['topic']}")


def read_messages(
    limit: int = 50,
    topic_filter: str | None = None,
    type_filter: str | None = None,
    agent_filter: str | None = None,
) -> None:
    ensure_board_file()
    records = []
    with open(BOARD_PATH, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    filtered = []
    for r in records:
        if topic_filter and topic_filter.lower() not in r.get("topic", "").lower():
            continue
        if type_filter and r.get("type", "").upper() != type_filter.upper():
            continue
        if agent_filter and agent_filter.lower() not in (r.get("from", "").lower() + " " + r.get("to", "").lower()):
            continue
        filtered.append(r)

    to_show = filtered[-limit:]
    if not to_show:
        print("Board is empty or no messages match filter.")
        return

    for r in to_show:
        ts = r.get("ts", "")[:19].replace("T", " ")
        print(f"[{ts}] [{r.get('type')}] {r.get('from')} -> {r.get('to')}: {r.get('topic')}")
        print(f"  {r.get('body')}")
        if r.get("refs"):
            print(f"  refs: {', '.join(r.get('refs'))}")
        print()


def render_board_digest() -> None:
    ensure_board_file()
    records = []
    with open(BOARD_PATH, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    lines = [
        "# Disha AI Agent Shared Brain (agent/BOARD.md)",
        f"*Auto-generated digest at {datetime.now(timezone.utc).isoformat()[:19]}Z*",
        "",
        "## Active Blockers & Requests",
    ]

    blockers = [r for r in records if r.get("type") in ("BLOCKER", "REQUEST")]
    if blockers:
        for b in blockers[-10:]:
            lines.append(f"- **[{b.get('type')}]** `{b.get('from')}` -> `{b.get('to')}`: **{b.get('topic')}**")
            lines.append(f"  > {b.get('body')}")
    else:
        lines.append("- *Zero active blockers.*")

    lines.extend([
        "",
        "## Key Decisions & Interface Changes",
    ])
    decisions = [r for r in records if r.get("type") in ("DECISION", "INTERFACE_CHANGE")]
    if decisions:
        for d in decisions[-15:]:
            lines.append(f"- **[{d.get('type')}]** `{d.get('from')}`: **{d.get('topic')}** — {d.get('body')}")
    else:
        lines.append("- *No recent architectural decisions posted.*")

    lines.extend([
        "",
        "## Recent Activity Log (Last 20)",
        "| Time (UTC) | Type | From | To | Topic |",
        "|---|---|---|---|---|",
    ])
    for r in records[-20:]:
        ts = r.get("ts", "")[:19].replace("T", " ")
        lines.append(f"| {ts} | {r.get('type')} | {r.get('from')} | {r.get('to')} | {r.get('topic')} |")

    content = "\n".join(lines) + "\n"
    with open(BOARD_MD_PATH, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"✓ Updated {BOARD_MD_PATH}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Disha AI Shared Agent Brain CLI")
    subparsers = parser.add_subparsers(dest="command")

    post_parser = subparsers.add_parser("post", help="Post a message to the agent board")
    post_parser.add_argument("--from", dest="from_agent", required=True, help="Sender agent name")
    post_parser.add_argument("--to", dest="to_agent", default="all", help="Recipient (agent name or 'all')")
    post_parser.add_argument("--type", dest="msg_type", default="FINDING", help=f"Message type: {', '.join(sorted(VALID_TYPES))}")
    post_parser.add_argument("--topic", required=True, help="Short subject / topic")
    post_parser.add_argument("--body", required=True, help="Message body content")
    post_parser.add_argument("--refs", help="Comma-separated file paths or symbol references")

    read_parser = subparsers.add_parser("read", help="Read messages from the agent board")
    read_parser.add_argument("--limit", type=int, default=30, help="Number of messages to display")
    read_parser.add_argument("--topic", help="Filter by topic keyword")
    read_parser.add_argument("--type", help="Filter by type")
    read_parser.add_argument("--agent", help="Filter by agent name")

    subparsers.add_parser("digest", help="Regenerate agent/BOARD.md digest")

    args = parser.parse_args()
    if args.command == "post":
        post_message(args.from_agent, args.to_agent, args.msg_type, args.topic, args.body, args.refs)
        render_board_digest()
    elif args.command == "read":
        read_messages(args.limit, args.topic, args.type, args.agent)
    elif args.command == "digest":
        render_board_digest()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()

