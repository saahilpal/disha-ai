#!/usr/bin/env python3
"""Docs drift validation utility for Disha AI.

Reads docs/OWNERS.yaml, verifies that all documented files exist, and validates
that code changes have accompanying documentation updates (or explicit docs: n/a exemption).
"""
from __future__ import annotations

import fnmatch
import subprocess
import sys
from pathlib import Path

WORKSPACE_ROOT = Path(__file__).resolve().parent.parent
OWNERS_FILE = WORKSPACE_ROOT / "docs" / "OWNERS.yaml"


def load_mappings() -> list[dict]:
    """Parse YAML mappings from docs/OWNERS.yaml without requiring heavy external pyyaml if possible."""
    if not OWNERS_FILE.exists():
        print(f"[FAIL] docs/OWNERS.yaml not found at {OWNERS_FILE}")
        sys.exit(1)

    try:
        import yaml
        content = yaml.safe_load(OWNERS_FILE.read_text(encoding="utf-8"))
        return content.get("mappings", [])
    except ImportError:
        # Fallback simple parser for OWNERS.yaml structure
        mappings = []
        current: dict = {}
        for line in OWNERS_FILE.read_text(encoding="utf-8").splitlines():
            line_str = line.strip()
            if line_str.startswith("- glob:"):
                if current:
                    mappings.append(current)
                current = {"glob": line_str.split(":", 1)[1].strip().strip('"'), "docs": []}
            elif line_str.startswith("- ") and "docs" in current and not line_str.startswith("- glob:"):
                doc_file = line_str.split("- ", 1)[1].strip().strip('"')
                if doc_file.endswith(".md"):
                    current["docs"].append(doc_file)
        if current:
            mappings.append(current)
        return mappings


def get_changed_files() -> list[str]:
    """Fetch uncommitted or staged modified files via git."""
    try:
        res = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=WORKSPACE_ROOT,
            capture_output=True,
            text=True,
            check=True,
        )
        changed = []
        for line in res.stdout.splitlines():
            if not line.strip():
                continue
            parts = line.strip().split(maxsplit=1)
            if len(parts) == 2:
                changed.append(parts[1].strip())
        return changed
    except Exception as exc:
        print(f"[-] Could not query git status: {exc}")
        return []


def main() -> int:
    mappings = load_mappings()
    if not mappings:
        print("[FAIL] No mappings found in docs/OWNERS.yaml")
        return 1

    print(f"[+] Loaded {len(mappings)} documentation ownership mapping rules.")

    # 1. Verify existence of all mapped doc targets
    missing_docs: list[str] = []
    for entry in mappings:
        for doc in entry.get("docs", []):
            if not (WORKSPACE_ROOT / doc).exists():
                missing_docs.append(f"{doc} (mapped from {entry.get('glob')})")

    if missing_docs:
        print("[FAIL] Mapped documentation files do not exist:")
        for m in sorted(set(missing_docs)):
            print(f"  - {m}")
        return 1

    print("[PASS] All mapped documentation files exist on disk.")

    # 2. Check recent commit message or git diff for docs exemption
    changed_files = get_changed_files()
    if not changed_files:
        print("[PASS] Working tree clean; docs drift check passed.")
        return 0

    print(f"[+] Found {len(changed_files)} changed files in working tree.")
    doc_changes = {f for f in changed_files if f.startswith("docs/") or f in {"README.md", "CHANGELOG.md"}}

    unmapped_code_drift: list[str] = []
    for ch in changed_files:
        if ch.startswith("docs/") or ch.startswith("agent/") or ch.startswith("tests/") or ch.endswith(".png"):
            continue
        # Find matching rule
        for rule in mappings:
            glob_pattern = rule.get("glob", "")
            if fnmatch.fnmatch(ch, glob_pattern) or fnmatch.fnmatch(ch, f"*/{glob_pattern}"):
                # Check if any mapped doc was touched
                rule_docs = set(rule.get("docs", []))
                if not (rule_docs & doc_changes):
                    unmapped_code_drift.append(f"{ch} -> requires {', '.join(rule_docs)}")

    if unmapped_code_drift and not doc_changes:
        print("[WARN] Code changes detected without mapped doc changes in current tree:")
        for drift in unmapped_code_drift[:5]:
            print(f"  - {drift}")
        print("Note: Ensure commit includes mapped doc changes or 'docs: n/a (reason)'.")
    else:
        print("[PASS] Docs drift check passed clean.")

    return 0


if __name__ == "__main__":
    sys.exit(main())
