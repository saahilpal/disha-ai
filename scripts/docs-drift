#!/usr/bin/env python3
"""Docs drift validation utility for Disha AI.

Enforces strictly the 6 canonical documentation files:
- README.md
- docs/HLD.md
- docs/LLD.md
- docs/DATA.md
- docs/EVALUATION.md
- docs/KNOWN_ISSUES.md

Ensures zero undocumented markdown sprawl across the codebase.
"""
from __future__ import annotations

import sys
from pathlib import Path

WORKSPACE_ROOT = Path(__file__).resolve().parent.parent

CANONICAL_DOCS = {
    Path("README.md"),
    Path("docs/HLD.md"),
    Path("docs/LLD.md"),
    Path("docs/DATA.md"),
    Path("docs/EVALUATION.md"),
    Path("docs/KNOWN_ISSUES.md"),
}


def main() -> int:
    errors: list[str] = []

    print("[+] Checking canonical documentation presence...")
    for doc in sorted(CANONICAL_DOCS):
        full_path = WORKSPACE_ROOT / doc
        if not full_path.exists():
            errors.append(f"Missing canonical documentation file: {doc}")
        elif full_path.stat().st_size == 0:
            errors.append(f"Canonical documentation file is empty: {doc}")

    # Scan for unauthorized markdown files in repo (tracked in git)
    print("[+] Checking for unauthorized markdown sprawl...")
    import subprocess
    res = subprocess.run(["git", "ls-files", "*.md"], cwd=WORKSPACE_ROOT, capture_output=True, text=True, check=True)
    found_md = {Path(p.strip()) for p in res.stdout.splitlines() if p.strip()}

    extraneous = found_md - CANONICAL_DOCS
    if extraneous:
        for extra in sorted(extraneous):
            errors.append(f"Unauthorized markdown file detected: {extra}")

    if errors:
        print("[FAIL] Docs validation failed:")
        for err in errors:
            print(f"  - {err}")
        return 1

    print(f"[PASS] All {len(CANONICAL_DOCS)} canonical documents verified with zero sprawl.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
