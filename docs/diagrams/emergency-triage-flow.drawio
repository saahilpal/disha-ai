        <mxCell id="c_ops" value="2. P0 Incident Klaxon on Hospital / Care Ops Emergency Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontStyle=1;" vertex="1" parent="careops_box">
          <mxGeometry x="510" y="40" width="440" height="40" as="geometry" />
