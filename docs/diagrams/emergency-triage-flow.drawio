<mxfile host="app.diagrams.net" modified="2026-11-05T09:10:00.000Z" agent="Antigravity Lead Architect" version="24.0.0" type="device">
  <diagram id="Disha-Emergency-Flow" name="Emergency Triage Flow & Deterministic Circuit Breaker">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

