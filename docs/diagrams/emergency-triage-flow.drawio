        <mxCell id="c_sms" value="1. Automated Emergency SMS &amp; WhatsApp to Registered Family Contact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontStyle=1;" vertex="1" parent="careops_box">
