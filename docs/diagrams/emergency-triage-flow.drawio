        <mxCell id="c_ledger" value="3. Append-Only Merkle Hash-Chained Audit Record in SQLite 'audit_claim_ledger'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontStyle=1;" vertex="1" parent="careops_box">
