        <mxCell id="title" value="DISHA AI - DETERMINISTIC EMERGENCY TRIAGE CIRCUIT BREAKER (&lt;0.01ms / ZERO MISSES)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- INPUT TRANSCRIPT -->
        <mxCell id="in_utterance" value="CALLER UTTERANCE (Voice ASR Transcript OR Typed Chat Message)&#xa;'Workout karte waqt achanak chhati mein ajeeb sa dabav lag raha hai&#xa;aur ulta haath sunn ho gaya... kya exercise continue karun?'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="700" height="70" as="geometry" />
        </mxCell>

        <!-- COMPILED AHO-CORASICK DFA -->
        <mxCell id="dfa_box" value="COMPILED AHO-CORASICK MULTI-PATTERN FINITE AUTOMATON&#xa;* 1,200+ Colloquial Hinglish Emergency Terms (Cardiac, Stroke, Anaphylaxis, Trauma)&#xa;* Time Complexity: O(N) where N = transcript character length&#xa;* Benchmark Execution Time: 3.5 to 8.2 microseconds (&lt;0.01ms) on single CPU core&#xa;* Memory Footprint: &lt;2MB (Resides permanently in CPU L2/L3 cache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="350" y="190" width="700" height="100" as="geometry" />
        </mxCell>

        <!-- DECISION BRANCH -->
        <mxCell id="branch" value="MATCH FOUND?&#xa;('chhati mein dabav' + 'ulta haath sunn')" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fca5a5;strokeColor=#b91c1c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- SAFE PATH -->
        <mxCell id="safe_path" value="NO MATCH (Safe Coaching Turn)&#xa;Proceed to JIT State Retrieval,&#xa;Prompt Assembly &amp; Groq LLM Leaf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="345" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- EMERGENCY MATCH PATH: HARD ABORT -->
        <mxCell id="hard_abort" value="CRITICAL RED-FLAG MATCHED (Failure #5 Intercepted)&#xa;1. HARD ABORT: LLM Generation Worker Instantly Canceled&#xa;2. ZERO Probabilistic Drift: LLM is Never Invoked&#xa;3. Audio Streamsevered at Telephony Trunk Level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecdd3;strokeColor=#e11d48;fontStyle=1;fontSize=13;fontColor=#881337;" vertex="1" parent="1">
          <mxGeometry x="450" y="470" width="500" height="80" as="geometry" />
        </mxCell>

        <!-- DUAL-CHANNEL EMERGENCY RESPONSE -->
        <mxCell id="resp_voice" value="VOICE CALL MODE RESPONSE&#xa;1. Retrieve pre-cached 24kHz broadcast WAV from RAM&#xa;2. Stream 112 Triage Speech immediately (0ms TTS lag):&#xa;   'Yeh sunkar lagta hai ki aapko turant medical attention ki zaroorat hai.&#xa;    Kripya bina kisi deri ke 112 dial karein ya hospital jayein...'&#xa;3. Graceful call disconnection after 5 seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="590" width="460" height="120" as="geometry" />
        </mxCell>

        <mxCell id="resp_chat" value="TEXT CHAT MODE RESPONSE&#xa;1. Lock chat input field (disable user typing)&#xa;2. Display Unmissable Red Emergency Card&#xa;3. Prominent '[ TAP TO CALL 112 NOW ]' Action Button&#xa;4. Display registered Emergency Contact phone number&#xa;5. Option to broadcast live GPS coordinates to Care Ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="460" height="120" as="geometry" />
        </mxCell>

        <!-- CARE OPS & AUDIT LEDGER -->
        <mxCell id="careops_box" value="CARE OPERATIONS &amp; AUDIT ESCALATION (P0 PRIORITY)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="750" width="980" height="160" as="geometry" />
