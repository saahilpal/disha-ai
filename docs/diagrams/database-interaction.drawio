        <mxCell id="q1" value="Query 1: FTS5 BM25 Match&#xa;SELECT rule_code, clinical_remedy&#xa;FROM clinical_rules_fts&#xa;WHERE clinical_rules_fts MATCH ?&#xa;ORDER BY rank LIMIT 2;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=10;fontFamily=Courier New;" vertex="1" parent="box_orchestrator">
